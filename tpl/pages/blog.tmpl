{{ define "title" }}Blog - Christian Kilb{{end}}
{{ define "canonical" }}https://kilb.tech/blog{{end}}
{{ define "metadescription" }}Articles about Christian Kilb's thoughts and learnings.{{end}}

{{ define "intro_text" }}
<ul class="flex flex-col gap-4 text-left">
    {{ range .posts }}
        {{ if .IsActive }}
            <li>
                <a href="/{{ .Id }}" class="no-underline flex items-center gap-4">
                    <span class="text-sm opacity-50 shrink-0 w-24">{{ .Date }}</span>
                    <img src="/static/img/posts/{{ .Id }}.webp" class="h-14 w-14 object-contain shrink-0" alt="{{ .Title }}">
                    <div class="flex-1">
                        <div class="font-semibold">{{ .Title }}</div>
                        <div class="text-sm opacity-60">{{ .Subtitle }}</div>
                    </div>
                </a>
            </li>
        {{ end }}
    {{end}}
</ul>
{{ end }}

{{ define "main" }}
    {{ template "teaser_intro" dict
        "Headline" "Blog"
        "SubHeadline" "Articles about my thoughts & learnings."
        "TeaserImage" "teasers/blog"
        "posts" .posts
    }}
{{ end }}
